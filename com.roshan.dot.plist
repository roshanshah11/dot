<?xml version="1.0" encoding="UTF-8"?>
<!DOCTYPE plist PUBLIC "-//Apple//DTD PLIST 1.0//EN" "http://www.apple.com/DTDs/PropertyList-1.0.dtd">
<plist version="1.0">
<dict>
	<key>Label</key>
	<string>com.roshan.dot</string>
	<key>ProgramArguments</key>
	<array>
		<string>__HOME__/Applications/Dot.app/Contents/MacOS/Dot</string>
	</array>
	<key>RunAtLoad</key>
	<true/>
	<key>KeepAlive</key>
	<false/>
	<key>ProcessType</key>
	<string>Interactive</string>
	<key>EnvironmentVariables</key>
	<dict>
		<key>PATH</key>
		<string>__HOME__/.local/bin:__HOME__/bin:/opt/homebrew/bin:/usr/local/bin:/usr/bin:/bin:/usr/sbin:/sbin</string>
	</dict>
	<key>StandardOutPath</key>
	<string>__HOME__/Library/Logs/Dot/launchd.out.log</string>
	<key>StandardErrorPath</key>
	<string>__HOME__/Library/Logs/Dot/launchd.err.log</string>
</dict>
</plist>
