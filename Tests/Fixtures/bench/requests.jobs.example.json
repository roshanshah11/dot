  {
   "id": "J1",
   "kind": "new",
   "group": "jobs",
   "ask": "open page one, then page two, then go back, then go to settings, notifications and email, and turn on email alerts",
   "flags": [],
   "setup": {
    "front": "bench-comet",
    "open_url": "{base}/index.html"
   },
   "expect": {
    "server_event": [
     {
      "type": "change",
      "id": "^email-alerts$",
      "checked": true
     },
     {
      "type": "get",
      "url": "/page2\\.html"
     }
    ],
    "act": {
     "verb": "open|click|back",
     "ok": true,
     "min_count": 6
    },
    "log_lacks": [
     "driven step cap",
     "driven time cap",
     "max steps",
     "agent\\["
    ],
    "job": {
     "placement": "front",
     "end": "done"
    },
    "no_agent": true,
    "cursor_unchanged": true
   },
   "limit_ms": 3500
  },
