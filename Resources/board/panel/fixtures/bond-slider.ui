<!-- expect: .slider-row .svg-figure ; slide: y=0.09 ; vars: y -->
<lead>A bond's price falls when its yield rises, because every coupon is discounted harder.</lead>
<state name="y" value="0.05"/>
<slider bind="y" min="0.01" max="0.12" step="0.005" label="yield" format="pct"/>
<text>A 10-year bond paying a 5% coupon on $100 is worth <b>{money(5 * (1 - pow(1 + y, -10)) / y + 100 / pow(1 + y, 10), 2)}</b> at a {pct(y)} yield.</text>
<svg viewBox="0 0 360 210">
  <line x1="40" y1="180" x2="340" y2="180" stroke="axis"/>
  <line x1="40" y1="20" x2="40" y2="180" stroke="axis"/>
  <text x="340" y="198" fill="muted" text-anchor="end" font-size="12">yield</text>
  <text x="46" y="26" fill="muted" font-size="12">price</text>
  <each in="range(1, 24)" as="k">
    <circle cx="{40 + k * 12.5}" cy="{180 - (5 * (1 - pow(1 + k * 0.005, -10)) / (k * 0.005) + 100 / pow(1 + k * 0.005, 10) - 50) * 1.6}" r="2.2" fill="c2"/>
  </each>
  <dot cx="{40 + y / 0.005 * 12.5}" cy="{180 - (5 * (1 - pow(1 + y, -10)) / y + 100 / pow(1 + y, 10) - 50) * 1.6}" r="6" color="c3" label="{money(5 * (1 - pow(1 + y, -10)) / y + 100 / pow(1 + y, 10), 0)}"/>
</svg>
<caption>Below a 5% yield the bond trades above par; above it, below par.</caption>
